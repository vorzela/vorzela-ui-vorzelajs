    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^24.19.2",
    "@vorzelajs/server": "0.0.21",
    "dompurify": "^3.4.17",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.107.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
